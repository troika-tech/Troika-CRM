# Database
# For MongoDB Atlas (Production)
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/database_name?retryWrites=true&w=majority&appName=Cluster0"

# For local development with SQLite (NOT for production):
# DATABASE_URL="file:./dev.db"

# NextAuth Configuration
# For production: https://your-domain.com
# For development: http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# NextAuth Secret - Generate with: openssl rand -base64 32
# IMPORTANT: Never commit the actual secret to version control!
NEXTAUTH_SECRET="generate-a-strong-secret-key-here"

# Node Environment
NODE_ENV="development"

# ──────────────────────────────────────────────────────────────────
# Calling-Agent → CRM Integration
# Shared HMAC secret used to authenticate inbound /api/integrations/
# calling-agent/events POSTs. Must match Calling-Agent backend's
# TROIKA_CRM_INTEGRATION_SECRET. Generate with: openssl rand -base64 48
# ──────────────────────────────────────────────────────────────────
CALLING_AGENT_INTEGRATION_SECRET=""
# Maximum clock skew (seconds) tolerated between Calling-Agent and CRM
# when verifying the X-Integration-Timestamp header. Defaults to 300s.
CALLING_AGENT_INTEGRATION_TIMESTAMP_WINDOW="300"
