// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String   @unique
  password      String
  role          String   @default("USER")
  status        String   @default("ACTIVE")
  leads         Lead[]
  assignedUserIds String[] @default([])
  callingData   CallingData[] @relation("DataAssignee")
  assignedCallingData CallingData[] @relation("DataAssigner")
  callingAgentLeads CallingAgentLead[] @relation("CallingAgentLeadOwner")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([role])
  @@index([status])
}

model Lead {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  customerName     String
  mobile           String
  email            String
  companyName      String?
  industryName     String?
  followUpDate     DateTime?
  shortDescription String?
  leadType         String?   @default("WhatsApp Marketing")
  createdById      String    @db.ObjectId
  createdBy        User      @relation(fields: [createdById], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([createdById])
  @@index([email])
  @@index([createdAt])
  @@index([followUpDate])
  @@index([customerName])
  @@index([leadType])
}

model CallingAgentLead {
  // External lead/transfer record pushed from the Calling-Agent backend.
  // Stored in its own collection rather than mixed into Lead to avoid
  // schema conflicts and keep filtering simple. Idempotency comes from
  // externalEventKey (unique) — duplicate POSTs upsert this single row.
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  externalEventKey   String   @unique
  eventType          String   // "lead" | "transfer"
  externalCallId     String
  callingUserId      String?
  agentId            String?
  agentName          String?
  crmUserId          String?  @db.ObjectId
  crmUser            User?    @relation("CallingAgentLeadOwner", fields: [crmUserId], references: [id])
  customerPhone      String
  campaignId         String?
  campaignName       String?
  callDateTime       DateTime?
  duration           Int?
  summary            String?
  // Stored as a JSON string for portability (Prisma Mongo Json fields
  // require parsing on read in some setups; strings are universally safe).
  transcriptJson     String?
  leadQualifierJson  String?
  leadReason         String?
  transferStatus     String?
  transferToNumber   String?
  recordingStatus    String?
  rawPayloadJson     String?  // full original payload for debugging
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([crmUserId, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@index([customerPhone])
  @@index([externalCallId])
  @@index([campaignId])
  @@index([createdAt])
}

model CallingData {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  number       String
  companyName  String?
  designation  String?
  status       String?
  assignedToId String   @db.ObjectId
  assignedTo   User     @relation("DataAssignee", fields: [assignedToId], references: [id])
  assignedById String   @db.ObjectId
  assignedBy   User     @relation("DataAssigner", fields: [assignedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([assignedToId])
  @@index([assignedById])
  @@index([createdAt])
}
